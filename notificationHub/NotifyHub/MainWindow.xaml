<Window x:Class="NotifyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyHub" Height="760" Width="540" MinWidth="380"
        Icon="pack://application:,,,/Package/Assets/NotifyHub.ico"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <DockPanel Margin="16">

        <!-- Search and filters -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox" Padding="8,6" VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource Border}"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Search titles, messages and app names"/>
                <TextBlock Text="Search notifications" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox x:Name="AppFilter" Grid.Column="1" Margin="0,0,8,0" Padding="8,6"
                      SelectionChanged="AppFilter_SelectionChanged"/>

            <Button Grid.Column="2" Content="Mark all read" Padding="12,6"
                    Click="MarkAllRead_Click"/>
        </Grid>

        <!-- Status line -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,10,0,0"
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

        <Grid>
            <!-- Empty state -->
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                       Foreground="{StaticResource TextMuted}"
                       Text="No notifications yet. New ones will appear here as soon as Windows shows them."/>

            <!-- Feed -->
            <ListBox x:Name="NotificationList" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     SelectionChanged="NotificationList_SelectionChanged"
                     MouseDoubleClick="NotificationList_MouseDoubleClick"
                     KeyDown="NotificationList_KeyDown">

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open app" Click="OpenApp_Click"/>
                        <MenuItem Header="Show in Windows notification center" Click="OpenNotificationCenter_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy text" Click="Copy_Click"/>
                        <MenuItem Header="Delete" Click="Delete_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource Card}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- App + time -->
                            <DockPanel>
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource Accent}"
                                         VerticalAlignment="Center" ToolTip="Unread">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LocalTime}"
                                           Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding AppName}" Foreground="{StaticResource TextMuted}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <!-- Title -->
                            <TextBlock Text="{Binding Title}" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextPrimary}" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="TextTrimming" Value="None"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Message: 3-line preview, full text when the card is selected -->
                            <TextBlock Text="{Binding Body}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}" Opacity="0.85">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="MaxHeight" Value="54"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBody}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="MaxHeight" Value="Infinity"/>
                                                <Setter Property="TextTrimming" Value="None"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Links and actions: only on the selected card -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,0,0,8">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLinks}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                <Hyperlink Click="Link_Click" ToolTip="{Binding}"
                                                           Foreground="{StaticResource Accent}">
                                                    <Run Text="{Binding Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel>
                                    <Button Content="Open app" Padding="12,5" Margin="0,0,8,0"
                                            IsEnabled="{Binding CanOpenApp}" Click="OpenApp_Click"
                                            ToolTip="Opens the app that sent this notification"/>
                                    <Button Content="Reply or act in Windows" Padding="12,5"
                                            Click="OpenNotificationCenter_Click"
                                            ToolTip="Opens the Windows notification center, where the original notification keeps its buttons and reply box"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
