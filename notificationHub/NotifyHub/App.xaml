<Application x:Class="NotifyHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#E1E4E8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2328"/>
        <SolidColorBrush x:Key="TextMuted" Color="#656D76"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    </Application.Resources>
</Application>
